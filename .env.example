# Copy this file to `.env` and replace the placeholders with your values:
#   cp .env.example .env
# `.env` is git-ignored: never commit it.

# --- Google Cloud / BigQuery ---------------------------------------------
# Your Google Cloud project ID (not its display name or number).
GCP_PROJECT_ID=your-gcp-project-id
# One BigQuery location for every dataset, chosen once (for example EU or US).
BQ_LOCATION=your-bigquery-location
# Dataset names. dbt dev targets add a suffix (for example staging_dev).
BQ_RAW_DATASET=raw
BQ_STAGING_DATASET=staging
BQ_MARTS_DATASET=marts

# --- Ingestion --------------------------------------------------------------
# Sending currencies fetched from the ECB, comma-separated ISO 4217 codes.
# EUR is the ECB base currency, so it is not listed.
ECB_CURRENCIES=USD,GBP

# --- dbt --------------------------------------------------------------------
# dbt target: `dev` writes to suffixed datasets, `prod` to the real ones.
DBT_TARGET=dev

# --- Airflow (local Docker Compose) -----------------------------------------
# User id inside the containers. macOS: keep 50000. Linux: use the output of `id -u`.
AIRFLOW_UID=50000
# Key used by Airflow to encrypt stored connection passwords. Generate one with:
#   uv run --no-sync python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key
# Login for the local Airflow UI (http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
